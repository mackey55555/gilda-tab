# Supabase の接続情報。値はダッシュボードの Project Settings > API Keys から。
# キーは新形式（publishable / secret）のみを使う。legacy の anon key / service_role JWT は使わない。

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# サーバ専用。RLS を貫通するので NEXT_PUBLIC_ を付けないこと。
# 用途はスタッフ追加（auth.users の作成）のみ。
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
